# ---------------------------------------------------------------------------
# Vouch - environment
#
# Copy to .env.local and fill in. .env* is gitignored; no value in this file is
# ever a real key.
#
# The whole app runs with none of these set. Without a Stripe key the payments
# and payouts screens fall back to the represented flow they shipped with, and
# say so on the page. Nothing 500s.
# ---------------------------------------------------------------------------

# Stripe secret key. USE A TEST KEY (sk_test_...).
# Dashboard > Developers > API keys, with the Test mode toggle on.
STRIPE_SECRET_KEY=

# Publishable key (pk_test_...). Not currently required - Connect onboarding and
# destination charges are both server-side - but kept here because any
# client-side Stripe Elements work would need it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Safety catch. The build refuses to use an sk_live_ key unless this is
# literally "true". A public demo that can charge a real card is a liability,
# not a feature.
STRIPE_ALLOW_LIVE=

# Absolute origin used to build Stripe redirect URLs, which cannot be relative.
# Optional: falls back to VERCEL_URL, then to the request's own origin.
NEXT_PUBLIC_SITE_URL=
